{
  "name": "@mambalabsdev/mcp-local-business-lead-builder",
  "version": "1.0.0",
  "description": "MCP server for Local Business Lead Builder. Build local business lead lists from Google Maps: one row per business with website, phone, address, coordinates, categories, rating, review count, and hours, for any category and place. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-local-business-lead-builder": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-maps",
    "local-business",
    "lead-generation",
    "local-seo",
    "business-leads",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/local-business-lead-builder",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-local-business-lead-builder"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-local-business-lead-builder"
}
